---
// The status tokens side by side, as a site would use them: what passed,
// what needs a look and what failed, beside the site's accent.
const rows = [
  ['--ap-ok', 'passed', 'sluice landed the bump'],
  ['--ap-warn', 'needs a look', 'an advisory on mise 2026.9.18; a source that has not answered'],
  ['--ap-bad', 'failed', 'the check of the change failed'],
  ['--ap-accent', 'accent', 'this site’s own colour'],
];
---

<ul class="status not-content">
  {
    rows.map(([token, name, example]) => (
      <li style={`--c: var(${token})`}>
        <span class="chip">{name}</span>
        <code>{token}</code>
        <span class="ex">{example}</span>
      </li>
    ))
  }
</ul>

<style>
  .status {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 7.5rem 7.5rem 1fr;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--ap-line);
    border-left: 3px solid var(--c);
    border-radius: var(--ap-radius-sm);
    background: var(--ap-bg-2);
  }
  .chip {
    justify-self: start;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--c) 18%, transparent);
    color: var(--c);
    font: 600 0.8rem/1.6 var(--ap-font-sans);
  }
  code {
    color: var(--ap-fg-3);
    font-size: 0.8rem;
  }
  .ex {
    color: var(--c);
    font-size: 0.9rem;
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: auto 1fr;
    }
    .ex {
      grid-column: 1 / -1;
    }
  }
</style>
